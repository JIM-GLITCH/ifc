{
  "name": "ifc-workspace",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.2.3"
  },
  "scripts": {
    "clean": "shx rm -rf ./vscode-extension/dist ./vscode-extension/*.tsbuildinfo",
    "generate:schema": "npm run build --prefix ../EXPRESS && node ../EXPRESS/packages/cli/bin/generate-schema.js ../EXPRESS/t.exp -o schema_gen.go",
    "generate": "npm run generate:schema && go generate ./...",
    "build": "npm run build --workspace=vscode-extension",
    "bundle": "npm run bundle --workspace=vscode-extension",
    "package": "npm run build --workspace=vscode-extension && npm run package --workspace=vscode-extension"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.27.0",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "vscode-extension"
  ]
}
