{
  "name": "ifc-vscode",
  "publisher": "lilr",
  "displayName": "Ifc",
  "description": "IFC (.ifc) language support with full EXPRESS WHERE validation — entity & type WHERE rules, Global RULE, UNIQUE, and DERIVE checks on ISO 10303-21 STEP files. Syntax highlighting, diagnostics, go-to-definition, and LSP for BIM workflows.",
  "version": "0.0.9",
  "license": "UNLICENSED",
  "icon": "icon.png",
  "keywords": [
    "ifc",
    "BIM",
    "STEP",
    "ISO 10303-21",
    "building information modeling",
    "language server",
    "LSP",
    "syntax highlighting",
    "EXPRESS",
    "WHERE",
    "schema validation",
    "AEC"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ifc.showValidationLayers",
        "title": "IFC: Toggle Validation Layers",
        "category": "IFC"
      }
    ],
    "configuration": {
      "title": "Ifc",
      "properties": {
        "ifc.validation.structure": {
          "type": "boolean",
          "default": true,
          "description": "Validate STEP encoding, attribute types, aggregate bounds, and entity keywords."
        },
        "ifc.validation.types": {
          "type": "boolean",
          "default": true,
          "description": "Evaluate Type WHERE rules and DERIVE expressions for * attributes."
        },
        "ifc.validation.rules": {
          "type": "boolean",
          "default": true,
          "description": "Evaluate entity WHERE rules, Global RULE, and UNIQUE constraints."
        }
      }
    },
    "languages": [
      {
        "id": "ifc",
        "aliases": [
          "Ifc",
          "Ifc"
        ],
        "extensions": [
          ".ifc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ifc",
        "scopeName": "source.ifc",
        "path": "./syntaxes/ifc.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "npm run check-types && node esbuild.js && npm run build-server",
    "bundle": "node esbuild.js --production",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish-vsce": "vsce publish --no-dependencies --allow-missing-repository",
    "publish-ovsx": "ovsx publish --no-dependencies",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "build-server": "go build -o dist/server.exe ../cmd/ifc-lsp"
  },
  "dependencies": {
    "vscode-languageclient": "~9.0.1"
  }
}
