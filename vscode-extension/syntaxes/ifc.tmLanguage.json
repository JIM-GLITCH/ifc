{
  "name": "ifc",
  "scopeName": "source.ifc",
  "fileTypes": [
    ".ifc"
  ],
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.ifc",
      "match": "\\b(?:ISO-10303-21|HEADER|DATA|ENDSEC|END-ISO-10303-21)\\b"
    },
    {
      "name": "entity.name.type.ifc",
      "match": "#[0-9]+"
    }
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.ifc",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ifc",
              "match": "''"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.ifc",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ifc"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ifc"
            }
          }
        }
      ]
    }
  }
}
